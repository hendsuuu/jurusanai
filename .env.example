# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database
# For local dev: postgresql://postgres:postgres@localhost:5432/bisnisapa
# For Neon production: use pooler URL here
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# For Neon: direct (non-pooler) URL for Prisma migrations
# Leave empty for local dev
DIRECT_URL=""

# Auth
AUTH_SECRET="change-this-to-random-secret-please"
AUTH_URL="http://localhost:3000"
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="change-this-password"

# Upstash Redis Rate Limit
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI Provider
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_PROVIDER="openai"
AI_RECOMMENDATION_MODEL="gpt-5.4-mini"
AI_PLAN_MODEL="gpt-5.4-mini"

# Midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_FINISH_REDIRECT_URL="http://localhost:3000/payment/finish"
MIDTRANS_UNFINISH_REDIRECT_URL="http://localhost:3000/payment/unfinish"
MIDTRANS_ERROR_REDIRECT_URL="http://localhost:3000/payment/error"

# PDF Storage
# Driver options: "local" (dev only, not for Vercel), "supabase" (recommended), "s3" (R2/AWS)
PDF_STORAGE_DRIVER="local"

# Supabase Storage (S3-compatible API) — recommended for production
# Step 1: Create a bucket at: Supabase Dashboard → Storage → New bucket
#          Name it (e.g. "juruscope"), set it to PRIVATE
# Step 2: Get S3 credentials at: Project Settings → Storage → S3 Access Keys → Generate
#          Copy the Access Key ID and Secret Access Key
# Step 3: Set SUPABASE_STORAGE_URL to: https://<project-ref>.storage.supabase.co/storage/v1/s3
# Step 4: Set SUPABASE_STORAGE_REGION to your project region (e.g. ap-southeast-1 for Singapore)
# Step 5: Set PDF_STORAGE_DRIVER="supabase"
SUPABASE_STORAGE_URL=""
SUPABASE_STORAGE_KEY=""
SUPABASE_STORAGE_SECRET=""
SUPABASE_STORAGE_REGION="ap-southeast-1"
SUPABASE_STORAGE_BUCKET=""

# S3/R2 Storage (leave empty if using Supabase)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""

# Email — Resend (https://resend.com)
# Production: verify your domain at https://resend.com/domains and set
# RESEND_FROM_EMAIL to a verified sender address.
# Development: leave EMAIL_DEV_MODE empty (auto-on when NODE_ENV !==
# "production"); the sender falls back to "onboarding@resend.dev" so
# you can test without verifying a domain. The recipient is always
# the actual buyer's email — dev and prod only differ in sender.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="BisnisApa AI <noreply@yourdomain.com>"

# Optional override:
# - EMAIL_DEV_MODE="true"  → force "onboarding@resend.dev" sender even in production
# - EMAIL_DEV_MODE="false" → force RESEND_FROM_EMAIL even in development
EMAIL_DEV_MODE=""

# Inngest — Background job queue
# Local dev: leave empty and run `npx inngest-cli@latest dev` to start the
#            local Dev Server (auto-discovers app via /api/inngest).
# Production: required. Get keys from https://app.inngest.com → your app → Keys.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Local dev escape hatch: when no Inngest Dev Server is running, set this
# to "true" to run the post-payment pipeline synchronously inside the
# webhook. NEVER enable in production. Defaults to "false".
ENABLE_SYNC_FALLBACK="false"
